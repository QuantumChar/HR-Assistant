# Public template only. Keep real resource names, IDs, endpoints, keys, and secrets in
# local environment variables or an approved secret store. Never commit those values.

# Azure AI Search endpoint. Replace <search-name> only in your local .env file.
AZURE_SEARCH_ENDPOINT=https://<search-name>.search.windows.net

# Search index name. This is not a secret, but should match your deployed index.
AZURE_SEARCH_INDEX=hr-knowledge

# Microsoft Foundry/OpenAI endpoint. Replace <foundry-account> only in your local .env file.
AZURE_OPENAI_ENDPOINT=https://<foundry-account>.openai.azure.com

# Model deployment name. Do not place an API key in this file; authentication uses Entra ID.
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# API contract version, not a credential.
AZURE_OPENAI_API_VERSION=2024-10-21

# If future integrations require tenant, subscription, client, or principal IDs, document them
# here as <tenant-id>, <subscription-id>, <client-id>, or <principal-object-id> placeholders only.
# Secrets and keys must never be added to this template.
